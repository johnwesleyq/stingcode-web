# Copy to .env and fill in.
PORT=3000
NODE_ENV=production

# First admin account (created on first start if no admin exists). Password: 10+ characters.
ADMIN_EMAIL=you@stingcode.com
ADMIN_PASSWORD=change-this-long-password

# Where the SQLite database file lives (back this file up!)
DATABASE_PATH=./data/stingcode.db

# Optional: turns on the "Ask our AI guide" chat. Get a key at console.anthropic.com
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-haiku-5-5

# Set to 1 when running behind a proxy/load balancer (Render, Railway, Nginx) so rate limits see real IPs
TRUST_PROXY=1
